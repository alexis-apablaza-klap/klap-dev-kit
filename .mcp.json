{
  "klap-knowledge-local-mock": {
    "type": "stdio",
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/mocks/klap-knowledge-mcp/server.mjs"]
  },
  "klap-knowledge": {
    "type": "stdio",
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/klap-knowledge-launch.mjs"]
  },
  "atlassian": {
    "type": "http",
    "url": "https://mcp.atlassian.com/v2/mcp"
  },
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp"
  },
  "sonarqube": {
    "type": "http",
    "url": "https://api.sonarcloud.io/mcp",
    "headers": {
      "Authorization": "Bearer ${KLAP_SONARQUBE_TOKEN}",
      "SONARQUBE_ORG": "multicaja-cloud",
      "SONARQUBE_READ_ONLY": "true"
    }
  }
}
