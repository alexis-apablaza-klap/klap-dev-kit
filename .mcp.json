{
  "klap-knowledge-local-mock": {
    "type": "stdio",
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/mocks/klap-knowledge-mcp/server.mjs"]
  },
  "klap-knowledge": {
    "type": "stdio",
    "command": "${KLAP_KNOWLEDGE_PYTHON:-python}",
    "args": ["-m", "klap_knowledge.server"],
    "cwd": "${KLAP_KNOWLEDGE_HOME}"
  },
  "atlassian": {
    "type": "http",
    "url": "https://mcp.atlassian.com/v2/mcp"
  }
}
