{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klap.cl/schemas/component.schema.json",
  "title": "component.yaml",
  "description": "Memoria técnica mínima de un componente/repositorio, versionada en Git. Fuente de verdad local que se relaciona con Klap Knowledge.",
  "type": "object",
  "required": ["componente", "repositorio", "productos", "capabilities", "tecnologias", "klap_knowledge"],
  "additionalProperties": false,
  "properties": {
    "componente": {
      "type": "string",
      "description": "Nombre lógico único del componente, p.ej. ms-central-sva-anticipo-calculos."
    },
    "descripcion": {
      "type": "string",
      "maxLength": 500
    },
    "repositorio": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "rama_principal": { "type": "string", "default": "main" }
      }
    },
    "productos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nombre"],
        "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "fase": {
            "type": "string",
            "enum": ["kickoff", "mvp", "fase-1", "mantencion"]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Capacidades de negocio que expone o soporta este componente."
    },
    "dependencias": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["componente"],
        "additionalProperties": false,
        "properties": {
          "componente": { "type": "string" },
          "tipo": {
            "type": "string",
            "enum": ["rest", "kafka", "base-datos-compartida", "libreria", "otro"]
          },
          "critica": { "type": "boolean", "default": false }
        }
      }
    },
    "apis_expuestas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nombre", "tipo"],
        "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "tipo": { "type": "string", "enum": ["rest", "graphql", "grpc", "kafka-producer"] },
          "ruta_contrato": { "type": "string", "description": "Path relativo al OpenAPI/AsyncAPI." },
          "version": { "type": "string" }
        }
      }
    },
    "apis_consumidas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nombre"],
        "additionalProperties": false,
        "properties": {
          "nombre": { "type": "string" },
          "componente_origen": { "type": "string" },
          "tipo": { "type": "string", "enum": ["rest", "graphql", "grpc", "kafka-consumer"] }
        }
      }
    },
    "datos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["motor", "esquema"],
        "additionalProperties": false,
        "properties": {
          "motor": { "type": "string", "enum": ["postgresql", "otro"] },
          "base": { "type": "string" },
          "esquema": { "type": "string" },
          "propietario": { "type": "boolean", "default": true }
        }
      }
    },
    "eventos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "rol"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string" },
          "rol": { "type": "string", "enum": ["productor", "consumidor"] },
          "schema_registry": { "type": "string" }
        }
      }
    },
    "tecnologias": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "p.ej. java-21, spring-boot-4, angular-21, gradle."
    },
    "klap_knowledge": {
      "type": "object",
      "description": "Datos mínimos para relacionar este componente con el grafo de Klap Knowledge.",
      "required": ["component_id"],
      "additionalProperties": false,
      "properties": {
        "component_id": { "type": "string", "description": "Identificador estable usado por Klap Knowledge para este componente." },
        "ultimo_targeted_sync": { "type": "string", "format": "date-time" }
      }
    }
  }
}
