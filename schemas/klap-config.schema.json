{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klap.cl/schemas/klap-config.schema.json",
  "title": "config/klap.yaml",
  "type": "object",
  "required": ["version", "mcp", "stack_soportado", "rutas", "contratos"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "mcp": {
      "type": "object",
      "required": ["knowledge", "atlassian"],
      "properties": {
        "knowledge": {
          "type": "object",
          "required": ["server", "modo"],
          "properties": {
            "server": { "type": "string" },
            "modo": { "type": "string", "enum": ["mock", "produccion"] },
            "fallback_si_no_disponible": { "type": "boolean" },
            "mock_launch": { "type": "array", "items": { "type": "string" } }
          }
        },
        "atlassian": {
          "type": "object",
          "required": ["server", "auth"],
          "properties": {
            "server": { "type": "string" },
            "endpoint": { "type": "string", "format": "uri" },
            "auth": {
              "type": "string",
              "enum": ["oauth"],
              "description": "Único mecanismo admitido: OAuth individual por dev vía /mcp. El enum tiene un solo valor a propósito — abrirlo a tokens debe ser un cambio explícito y revisable, no un descuido de configuración."
            },
            "productos": {
              "type": "array",
              "items": { "type": "string", "enum": ["jira", "confluence", "bitbucket"] }
            }
          }
        },
        "sonarqube": {
          "type": "object",
          "properties": { "server": { "type": "string" } }
        }
      }
    },
    "stack_soportado": { "type": "object" },
    "memoria": {
      "type": "object",
      "properties": {
        "repo_path": { "type": "string" },
        "workspace_root": {
          "type": "string",
          "description": "Ruta (relativa a la raíz de este repo) a la carpeta que contiene las carpetas de cada producto (p.ej. <workspace_root>/abono-ya/<repo>). Usada por scripts/descubrir-componentes.mjs para el escaneo local — no requiere que exista si el descubrimiento de componentes no se usa en este entorno."
        }
      }
    },
    "rutas": {
      "type": "object",
      "required": ["standards_index", "quality_gates", "context_index_schema", "knowledge_mcp_contract"],
      "additionalProperties": { "type": "string" }
    },
    "hosting": { "type": "object" },
    "contratos": {
      "type": "object",
      "required": ["knowledge_mcp"],
      "properties": {
        "knowledge_mcp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Versión de schemas/knowledge-mcp/tools.json contra la que el kit fue validado (debe coincidir con tools.json → contractVersion)."
        }
      }
    }
  }
}
